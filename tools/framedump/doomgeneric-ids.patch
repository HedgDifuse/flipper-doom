diff --git a/doomgeneric/dg_ids.h b/doomgeneric/dg_ids.h
new file mode 100644
index 0000000..6ef7d11
--- /dev/null
+++ b/doomgeneric/dg_ids.h
@@ -0,0 +1,15 @@
+// Per-pixel object ID buffer for the dithering lab (not part of the port).
+// id = class << 12 | index. Classes below.
+#ifndef DG_IDS_H
+#define DG_IDS_H
+#include <stdint.h>
+#include "i_video.h"
+enum { DGID_NONE, DGID_WALL, DGID_PLANE, DGID_SPRITE, DGID_WEAPON, DGID_SKY };
+extern uint16_t dg_idbuf[SCREENWIDTH * SCREENHEIGHT];
+extern uint16_t dg_curid;
+#define DG_ID(cls, idx) dg_curid = (uint16_t)(((cls) << 12) | ((idx) & 0xfff))
+#define DG_ID_COL() do { for (int _y = dc_yl; _y <= dc_yh; _y++) \
+    dg_idbuf[ylookup[_y] + columnofs[dc_x] - I_VideoBuffer] = dg_curid; } while (0)
+#define DG_ID_SPAN() do { for (int _x = ds_x1; _x <= ds_x2; _x++) \
+    dg_idbuf[ylookup[ds_y] + columnofs[_x] - I_VideoBuffer] = dg_curid; } while (0)
+#endif
